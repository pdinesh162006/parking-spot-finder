# ParkEase Backend Environment Variables (Template)

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/parkease?schema=public

# Redis
REDIS_URL=redis://127.0.0.1:6379

# JWT (RS256 keys auto-generated at startup if not set)
# JWT_PRIVATE_KEY=
# JWT_PUBLIC_KEY=
JWT_ACCESS_SECRET=your_access_secret_here
JWT_REFRESH_SECRET=your_refresh_secret_here

# Stripe
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# AWS S3 (leave as mock_aws_key for local fallback)
AWS_ACCESS_KEY_ID=mock_aws_key
AWS_SECRET_ACCESS_KEY=mock_aws_secret
S3_BUCKET_NAME=parkease-bucket
AWS_REGION=us-east-1

# Email (leave blank for console logging fallback)
SENDGRID_API_KEY=
FROM_EMAIL=no-reply@parkease.local

# Server
FRONTEND_URL=http://localhost:5173
PORT=5000
NODE_ENV=development
